# --- 目标芯片 (FoloToy AI Passport: ESP32-C3, 8MiB, 无 PSRAM) ---
CONFIG_IDF_TARGET="esp32c3"

# --- Flash ---
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG (UART0 TX=GPIO21 与背光冲突,禁用) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL:RGB565, 官方池 24KiB ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# pa_font_16 is lv_font_conv bpp 2 without --no-compress, so bitmap_format is 1
# (RLE + prefilter). LVGL 9.5 returns no glyph bitmap unless this is on, and the
# deck screen stays the near-black background with no text.
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# GPIO0 already has a board-level 10k pull-up for the ADC-ladder buttons.
CONFIG_ESP_SLEEP_GPIO_ENABLE_INTERNAL_RESISTORS=n

# --- 无线电:v1 不使用 Wi-Fi/BLE,显式锁定 ---
CONFIG_BT_ENABLED=n
